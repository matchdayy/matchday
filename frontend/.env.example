# Скопируйте этот файл в frontend/.env.local и поменяйте значение.
# .env.local в git не попадает, у каждого он свой.
# После изменения перезапустите фронтенд: docker compose restart frontend

# true  — данные из src/api/mocks, бэкенд не нужен
# false — настоящий API через прокси /api (vite.config.ts)
VITE_USE_MOCKS=false
