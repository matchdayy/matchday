# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# Файл .env в репозиторий не попадает — он в .gitignore.

POSTGRES_DB=matchday
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Ключ, которым сервер подписывает токены входа. Для разработки подойдёт
# этот. На сервере должен быть другой, длинный и случайный, и в репозиторий
# он не попадает: кто знает ключ, может войти под любым пользователем.
# Не короче 32 символов: на более короткий ключ pyjwt выдаёт предупреждение.
APP_SECRET_KEY=dev-secret-change-me-on-the-real-server
